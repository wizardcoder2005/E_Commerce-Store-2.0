<div class="group relative flex flex-col bg-white rounded-premium overflow-hidden transition-all duration-300 hover:-translate-y-1 h-full" style="box-shadow: 0 4px 20px rgba(0,0,0,0.05);">
  
  <!-- Discount Badge -->
  {% if product.compare_at_price > product.price %}
    {% assign discount = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round %}
    <div class="absolute top-3 left-3 z-10 bg-zonura-alert text-white font-sans text-[10px] font-bold px-2.5 py-1 rounded-full tracking-wide">
      {{ discount }}% OFF
    </div>
  {% endif %}

  <!-- Wishlist Icon -->
  <button type="button" class="wishlist-btn absolute top-3 right-3 z-10 p-1.5 bg-white/80 backdrop-blur-sm rounded-full text-zonura-secondary hover:text-zonura-alert transition-colors focus:outline-none" data-product-id="{{ product.id }}">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" /></svg>
  </button>

  <!-- Image Link -->
  <a href="{{ product.url }}" class="relative aspect-[4/5] bg-zonura-sand/20 overflow-hidden block">
    <img src="{{ product.featured_image | img_url: '600x' }}" alt="{{ product.featured_image.alt | escape | default: product.title | escape }}" class="absolute inset-0 w-full h-full object-cover transition-opacity duration-500 {% if product.images.size > 1 %}group-hover:opacity-0{% endif %}" loading="lazy" />
    {% if product.images.size > 1 %}
      <img src="{{ product.images[1] | img_url: '600x' }}" alt="{{ product.images[1].alt | escape | default: product.title | escape }}" class="absolute inset-0 w-full h-full object-cover transition-opacity duration-500 opacity-0 group-hover:opacity-100" loading="lazy" />
    {% endif %}
  </a>

  <!-- Details -->
  <div class="p-4 flex flex-col flex-1">
    <h3 class="font-sans font-bold text-zonura-navy text-sm mb-1 truncate"><a href="{{ product.url }}" class="hover:text-zonura-gold transition-colors">{{ product.title }}</a></h3>
    
    <!-- Rating -->
    <div class="mb-2">
      {% render 'judgeme_widgets', widget_type: 'judgeme_preview_badge', jm_style: '', concierge_install: true, product: product %}
    </div>

    <!-- Price -->
    <div class="mt-auto flex items-end gap-2 mb-4">
      <span class="font-serif font-bold text-zonura-navy text-lg leading-none">{{ product.price | money }}</span>
      {% if product.compare_at_price > product.price %}
        <span class="font-sans text-xs text-zonura-navy/50 line-through leading-none mb-0.5">{{ product.compare_at_price | money }}</span>
      {% endif %}
    </div>

    <!-- Hover/Mobile ATC -->
    {% form 'product', product, class: 'mt-auto' %}
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      <button type="submit" name="add" class="w-full py-2.5 flex items-center justify-center rounded-[10px] bg-zonura-action text-white font-sans text-xs font-bold tracking-wider hover:bg-zonura-navy transition-all lg:opacity-0 lg:translate-y-2 group-hover:opacity-100 group-hover:translate-y-0 {% unless product.available %}opacity-50 cursor-not-allowed lg:opacity-50{% endunless %}" {% unless product.available %}disabled{% endunless %}>
        {% if product.available %}ADD TO CART{% else %}SOLD OUT{% endif %}
      </button>
    {% endform %}
  </div>
</div>
