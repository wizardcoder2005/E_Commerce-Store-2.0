        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Fast Delivery"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Ships in 2-5 days"
        }
      ]
    }
  ],
