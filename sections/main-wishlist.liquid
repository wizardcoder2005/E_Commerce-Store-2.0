<div class="max-w-[1600px] mx-auto px-4 md:px-8 py-12 md:py-20">
  <div class="flex flex-col items-center justify-center text-center mb-12">
    <h1 class="font-serif text-4xl md:text-5xl text-zonura-navy mb-4">My Wishlist</h1>
    <p class="font-sans text-sm text-zonura-navy/60 max-w-lg">Your curated selection of wellness and self-care tools. Items saved here will remain on this device.</p>
  </div>

  <div id="wishlist-grid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4 md:gap-6">
    <!-- JS populates here -->
  </div>
  
  <div id="wishlist-empty" class="hidden flex flex-col items-center justify-center py-20 bg-zonura-sand/20 rounded-[14px]">
    <svg class="w-16 h-16 text-zonura-navy/20 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" /></svg>
    <p class="font-sans text-lg text-zonura-navy mb-6">Your wishlist is currently empty.</p>
    <a href="/collections/all" class="bg-zonura-navy text-white px-8 py-3.5 rounded-full font-sans font-bold text-sm tracking-widest uppercase hover:bg-zonura-gold hover:text-zonura-navy transition-colors">Start Shopping</a>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const wishlistKey = 'zonura_wishlist';
    const wishlist = JSON.parse(localStorage.getItem(wishlistKey) || '[]');
    const grid = document.getElementById('wishlist-grid');
    const emptyState = document.getElementById('wishlist-empty');

    if (wishlist.length === 0) {
      emptyState.classList.remove('hidden');
      return;
    }

    // Fetch products
    const fetchPromises = wishlist.map(id => {
      return fetch(`/search?q=id:${id}&view=rv-ajax`).then(res => res.text());
    });

    Promise.all(fetchPromises).then(results => {
      let found = 0;
      results.forEach(html => {
        if(html && html.trim().length > 0) {
          found++;
          const wrapper = document.createElement('div');
          wrapper.className = 'w-full';
          wrapper.innerHTML = html;
          grid.appendChild(wrapper);
        }
      });
      if(found === 0) {
        emptyState.classList.remove('hidden');
      }
    });
  });
</script>

{% schema %}
{
  "name": "Wishlist Page",
  "settings": []
}
{% endschema %}
