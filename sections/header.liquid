<div class="flex flex-col sticky top-0 z-50 shadow-sm relative">
  <!-- Utility Bar (top, small) -->
  {% if section.settings.show_utility_bar %}
    <div class="bg-zonura-navy text-white px-4 py-1.5 flex justify-between items-center text-xs font-sans">
      <div class="flex items-center gap-4">
        {% if section.settings.utility_text_1 != blank %}
          <span class="flex items-center gap-1 opacity-90">
            {{ section.settings.utility_text_1 }}
          </span>
        {% endif %}
        {% if section.settings.utility_text_1 != blank and section.settings.utility_text_2 != blank %}
          <span class="hidden md:block opacity-90">|</span>
        {% endif %}
        {% if section.settings.utility_text_2 != blank %}
          <span class="hidden md:block opacity-90 font-bold text-zonura-gold">{{ section.settings.utility_text_2 }}</span>
        {% endif %}
      </div>
      <div class="flex items-center gap-4 md:gap-6 opacity-90">
        {% if section.settings.utility_link_1_text != blank %}
          <a href="{{ section.settings.utility_link_1_url }}" class="hover:text-zonura-gold transition-colors">{{ section.settings.utility_link_1_text }}</a>
        {% endif %}
        {% if section.settings.utility_link_1_text != blank and section.settings.utility_link_2_text != blank %}
          <span class="opacity-50">|</span>
        {% endif %}
        {% if section.settings.utility_link_2_text != blank %}
          <a href="{{ section.settings.utility_link_2_url }}" class="hover:text-zonura-gold transition-colors">{{ section.settings.utility_link_2_text }}</a>
        {% endif %}
      </div>
    </div>
  {% endif %}

  <!-- Main Navigation -->
  <div class="bg-white px-4 lg:px-8 py-4 flex items-center justify-between border-b border-zonura-navy/5">
    
    <!-- Mobile Hamburger -->
    <button id="mobile-menu-btn" class="lg:hidden p-1 text-zonura-navy focus:outline-none" aria-label="Open menu">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" /></svg>
    </button>

    <!-- Logo -->
    <a href="{{ routes.root_url }}" class="flex items-center shrink-0">
      {% if section.settings.logo != blank %}
        <img src="{{ section.settings.logo | image_url: width: section.settings.logo_width }}" alt="{{ shop.name }}" style="max-width: {{ section.settings.logo_width }}px; height: auto;" class="object-contain transition-all" />
      {% else %}
        <span class="font-serif text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-zonura-navy">{{ shop.name }}</span>
      {% endif %}
    </a>

    <!-- Desktop Nav Links -->
    <nav class="hidden lg:flex items-center gap-8 absolute left-1/2 -translate-x-1/2">
      {% assign main_menu = linklists[section.settings.menu] %}
      {% if main_menu.links.size > 0 %}
        {% for link in main_menu.links %}
          {% if link.links.size > 0 %}
            <!-- Dropdown Trigger -->
            <div class="group relative py-4">
              <button class="flex items-center gap-1 font-sans text-[13px] font-bold text-zonura-navy hover:text-zonura-gold transition-colors uppercase tracking-wide">
                {{ link.title }}
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
              </button>
              <!-- Dropdown Menu -->
              <div class="absolute top-full left-1/2 -translate-x-1/2 w-[600px] bg-white shadow-2xl border border-zonura-navy/10 rounded-premium p-8 hidden group-hover:flex gap-8 z-50">
                <div class="flex-1 space-y-4">
                  {% for childlink in link.links %}
                    <a href="{{ childlink.url }}" class="block font-sans text-sm font-bold text-zonura-navy hover:text-zonura-gold transition-colors">{{ childlink.title }}</a>
                  {% endfor %}
                </div>
              </div>
            </div>
          {% else %}
            <a href="{{ link.url }}" class="font-sans text-[13px] font-bold text-zonura-navy hover:text-zonura-gold transition-colors uppercase tracking-wide">{{ link.title }}</a>
          {% endif %}
        {% endfor %}
      {% else %}
        <span class="font-sans text-[13px] text-zonura-navy/60">Select a menu in theme settings</span>
      {% endif %}
    </nav>

    <!-- Icons: Search, Account, Cart -->
    <div class="flex items-center gap-4 lg:gap-6 shrink-0">
      
      <!-- Search Form (Desktop) -->
      <form action="{{ routes.search_url }}" method="get" class="relative hidden md:block">
        <input type="text" name="q" placeholder="Search..." class="w-48 lg:w-64 bg-zonura-sand/20 border border-zonura-navy/10 rounded-full py-2 pl-4 pr-10 text-sm font-sans text-zonura-navy focus:outline-none focus:ring-1 focus:ring-zonura-gold transition-all" />
        <button type="submit" class="absolute right-3 top-1/2 -translate-y-1/2 text-zonura-navy/60 hover:text-zonura-gold transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
        </button>
        <!-- Predictive Search Dropdown container -->
        <div id="predictive-search-results" class="absolute top-full right-0 w-80 bg-white shadow-2xl border border-zonura-navy/10 rounded-premium mt-2 hidden z-50"></div>
      </form>

      <!-- Search Icon (Mobile) -->
      <button class="md:hidden text-zonura-navy focus:outline-none" aria-label="Search">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
      </button>

      <a href="{{ routes.account_url }}" class="text-zonura-navy hover:text-zonura-gold transition-colors hidden md:block">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
      </a>

      <a href="{{ routes.cart_url }}" class="relative cart-icon-toggle text-zonura-navy hover:text-zonura-gold transition-colors">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>
        <span class="cart-count-badge absolute -top-2 -right-2 bg-zonura-gold text-zonura-navy text-[10px] font-bold w-4 h-4 rounded-full flex items-center justify-center {% if cart.item_count == 0 %}hidden{% endif %}">{{ cart.item_count }}</span>
      </a>

    </div>
  </div>
</div>

<!-- Mobile Menu Drawer (Hamburger opens this) -->
<div id="mobile-menu-overlay" class="fixed inset-0 bg-zonura-navy/50 backdrop-blur-sm z-[60] opacity-0 pointer-events-none transition-opacity duration-300"></div>
<div id="mobile-menu-drawer" class="fixed top-0 left-0 h-full w-4/5 max-w-sm bg-white z-[70] transform -translate-x-full transition-transform duration-300 shadow-2xl flex flex-col">
  <div class="p-6 border-b border-zonura-navy/10 flex justify-between items-center bg-zonura-sand/20">
    <span class="font-serif text-2xl font-bold tracking-tight text-zonura-navy">{{ shop.name }}</span>
    <button id="mobile-menu-close" class="p-2 text-zonura-navy focus:outline-none">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
    </button>
  </div>
  
  <nav class="flex flex-col p-6 gap-6 overflow-y-auto flex-1">
    {% if main_menu.links.size > 0 %}
      {% for link in main_menu.links %}
        {% if link.links.size > 0 %}
          <div class="border-b border-zonura-navy/10 pb-4">
            <span class="font-sans text-lg font-bold text-zonura-navy uppercase tracking-wide mb-4 block">{{ link.title }}</span>
            <div class="flex flex-col gap-3 pl-4">
              {% for childlink in link.links %}
                <a href="{{ childlink.url }}" class="font-sans text-sm font-semibold text-zonura-navy/80 hover:text-zonura-gold transition-colors">{{ childlink.title }}</a>
              {% endfor %}
            </div>
          </div>
        {% else %}
          <a href="{{ link.url }}" class="font-sans text-lg font-bold text-zonura-navy hover:text-zonura-gold transition-colors uppercase tracking-wide">{{ link.title }}</a>
        {% endif %}
      {% endfor %}
    {% endif %}
  </nav>

  <div class="mt-auto p-6 border-t border-zonura-navy/10 bg-zonura-sand/20">
    <a href="{{ routes.account_url }}" class="flex items-center gap-4 text-zonura-navy font-sans font-bold text-sm tracking-widest uppercase">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
      Login / Profile
    </a>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 300,
      "step": 10,
      "default": 150,
      "unit": "px",
      "label": "Custom logo width"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main Navigation Menu",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "Utility Bar"
    },
    {
      "type": "checkbox",
      "id": "show_utility_bar",
      "label": "Show Utility Bar",
      "default": true
    },
    {
      "type": "text",
      "id": "utility_text_1",
      "label": "Utility Text 1",
      "default": "🇮🇳 Deliver to India"
    },
    {
      "type": "text",
      "id": "utility_text_2",
      "label": "Utility Text 2",
      "default": "Free Shipping above Rs.499"
    },
    {
      "type": "text",
      "id": "utility_link_1_text",
      "label": "Link 1 Text",
      "default": "Track Order"
    },
    {
      "type": "url",
      "id": "utility_link_1_url",
      "label": "Link 1 URL"
    },
    {
      "type": "text",
      "id": "utility_link_2_text",
      "label": "Link 2 Text",
      "default": "Customer Care"
    },
    {
      "type": "url",
      "id": "utility_link_2_url",
      "label": "Link 2 URL"
    }
  ]
}
{% endschema %}
