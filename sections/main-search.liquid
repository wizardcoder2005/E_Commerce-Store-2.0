<div class="max-w-[1600px] mx-auto px-4 md:px-8 py-12 md:py-16">
  
  <div class="max-w-2xl mx-auto text-center mb-12">
    <h1 class="font-serif text-4xl text-zonura-navy mb-6">Search</h1>
    <form action="{{ routes.search_url }}" method="get" class="relative w-full flex shadow-sm">
      <input type="text" name="q" value="{{ search.terms | escape }}" placeholder="Search for wellness, serums, oils..." class="w-full bg-zonura-sand/20 border border-zonura-navy/10 rounded-l-[14px] py-4 px-6 text-sm font-sans text-zonura-navy focus:outline-none focus:ring-2 focus:ring-zonura-gold/50 focus:border-zonura-gold/50 transition-all placeholder:text-zonura-navy/40" />
      <button type="submit" class="bg-zonura-gold hover:bg-zonura-gold/90 transition-colors px-8 rounded-r-[14px] text-zonura-navy flex items-center justify-center font-bold tracking-wider text-sm">
        SEARCH
      </button>
    </form>
  </div>

  {% if search.performed %}
    <div class="flex flex-col lg:flex-row gap-8 lg:gap-12 items-start">
      
      <!-- Mobile Filter Sticky Button -->
      {% if search.results_count > 0 %}
      <div class="lg:hidden fixed bottom-6 left-1/2 -translate-x-1/2 z-40 w-[90%] max-w-sm">
        <button type="button" id="mobile-filter-btn" class="w-full bg-zonura-navy text-white px-6 py-3.5 rounded-full font-sans font-bold text-sm tracking-widest uppercase flex items-center justify-center gap-2 shadow-2xl">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" /></svg>
          Filter & Sort
        </button>
      </div>

      <!-- Filter Overlay/Drawer -->
      <div id="filter-overlay" class="fixed inset-0 bg-zonura-navy/50 backdrop-blur-sm z-[60] opacity-0 pointer-events-none transition-opacity lg:hidden"></div>
      <aside id="filter-drawer" class="fixed inset-y-0 right-0 w-full max-w-[320px] bg-white z-[70] transform translate-x-full transition-transform lg:static lg:w-64 lg:translate-x-0 lg:shrink-0 lg:z-auto lg:top-32 h-full lg:h-auto overflow-y-auto lg:overflow-visible p-6 lg:p-0 shadow-2xl lg:shadow-none">
        <div class="flex items-center justify-between lg:hidden mb-8 border-b border-zonura-navy/10 pb-4">
          <h2 class="font-serif text-2xl text-zonura-navy">Filters</h2>
          <button type="button" id="filter-close-btn" class="p-2 text-zonura-navy">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
          </button>
        </div>

        <h2 class="hidden lg:block font-sans font-bold text-sm tracking-widest uppercase text-zonura-navy mb-6">Filter By</h2>
        <form id="collection-filters-form" class="flex flex-col gap-8">
          <input type="hidden" name="q" value="{{ search.terms | escape }}">
          {% for filter in search.filters %}
            <div class="border-b border-zonura-navy/10 pb-6">
              <h3 class="font-sans font-bold text-sm text-zonura-navy mb-4">{{ filter.label }}</h3>
              <ul class="flex flex-col gap-3">
                {% for value in filter.values %}
                  <li class="flex items-center gap-3 group cursor-pointer">
                    <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" id="Filter-{{ filter.param_name }}-{{ forloop.index }}"
                      {% if value.active %}checked{% endif %}
                      {% if value.count == 0 and value.active == false %}disabled{% endif %}
                      class="w-4 h-4 border-zonura-navy/20 rounded-sm text-zonura-gold focus:ring-zonura-navy transition-colors cursor-pointer"
                    >
                    <label for="Filter-{{ filter.param_name }}-{{ forloop.index }}" class="font-sans text-sm text-zonura-navy/80 group-hover:text-zonura-navy cursor-pointer {% if value.count == 0 and value.active == false %}opacity-50{% endif %}">
                      {{ value.label | escape }} ({{ value.count }})
                    </label>
                  </li>
                {% endfor %}
              </ul>
            </div>
          {% endfor %}
          <div class="flex items-center justify-between">
            <button type="submit" class="bg-zonura-navy text-white px-6 py-2.5 rounded-[14px] text-xs font-bold uppercase tracking-wider hover:bg-zonura-navy/90 transition-colors">Apply</button>
            <a href="{{ routes.search_url }}?q={{ search.terms | escape }}" class="text-xs font-sans text-zonura-navy/60 hover:text-zonura-navy underline">Clear</a>
          </div>
        </form>
      </aside>
      {% endif %}

      <div class="flex-1 w-full">
        <div class="flex justify-between items-center mb-6 border-b border-zonura-navy/10 pb-4">
          <span class="font-sans text-sm font-bold text-zonura-navy">
            Showing {{ search.results_count }} results for "{{ search.terms | escape }}"
          </span>
          {% if search.results_count > 0 %}
          <div class="flex items-center gap-2">
            <label class="font-sans text-sm text-zonura-navy/60">Sort by:</label>
            <select class="font-sans text-sm text-zonura-navy bg-transparent border-b border-zonura-navy/20 py-1 focus:outline-none focus:border-zonura-gold cursor-pointer" onchange="location = this.value;">
              {% for option in search.sort_options %}
                <option value="?q={{ search.terms | escape }}&sort_by={{ option.value }}" {% if option.value == search.sort_by %}selected{% endif %}>{{ option.name }}</option>
              {% endfor %}
            </select>
          </div>
          {% endif %}
        </div>

        {% if search.results_count == 0 %}
          <div class="text-center py-12 mb-12 bg-zonura-sand/20 rounded-[14px] border border-zonura-navy/5">
            <p class="font-serif text-2xl text-zonura-navy mb-4">No results for "{{ search.terms | escape }}"</p>
            <p class="font-sans text-sm text-zonura-navy/60">Try adjusting your search or explore our popular products instead.</p>
          </div>
          
          <h2 class="font-serif text-2xl text-zonura-navy mb-6">Popular Products</h2>
          <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
            {% for product in collections['featured-products'].products limit: 4 %}
              {% render 'product-card', product: product %}
            {% else %}
              {% for product in collections['all'].products limit: 4 %}
                {% render 'product-card', product: product %}
              {% endfor %}
            {% endfor %}
          </div>
        {% else %}
          <div class="grid grid-cols-2 {% if section.settings.columns_desktop == '3' %}lg:grid-cols-3{% else %}lg:grid-cols-4{% endif %} gap-4 md:gap-6">
            {% paginate search.results by section.settings.products_per_page %}
              {% for item in search.results %}
                {% if item.object_type == 'product' %}
                  {% render 'product-card', product: item %}
                {% endif %}
              {% endfor %}

              <!-- Pagination / Load More -->
              {% if paginate.next %}
                <div class="col-span-full flex justify-center mt-12 load-more-container">
                  <button type="button" class="bg-zonura-navy text-white px-8 py-3 rounded-[14px] font-sans font-bold tracking-wider text-sm hover:bg-zonura-navy/90 transition-colors shadow-lg shadow-zonura-navy/20" id="load-more-btn" data-next-url="{{ paginate.next.url }}">
                    LOAD MORE
                  </button>
                </div>
              {% endif %}
            {% endpaginate %}
          </div>
        {% endif %}
      </div>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Search Results",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "label": "Products per page",
      "default": 16
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Number of columns on desktop",
      "options": [
        {
          "value": "3",
          "label": "3 columns"
        },
        {
          "value": "4",
          "label": "4 columns"
        }
      ],
      "default": "4"
    }
  ],
  "presets": [{"name": "Search Results"}]
}
{% endschema %}
