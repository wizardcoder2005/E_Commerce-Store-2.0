<div class="w-full max-w-[1600px] mx-auto px-4 md:px-8 py-16 md:py-32">
  <!-- Breadcrumbs -->
  <nav class="flex items-center gap-2 font-sans text-xs text-zonura-navy/60 mb-6">
    <a href="{{ routes.root_url }}" class="hover:text-zonura-gold transition-colors">Home</a>
    <span>/</span>
    <a href="{{ routes.all_products_collection_url }}" class="hover:text-zonura-gold transition-colors">Products</a>
    <span>/</span>
    <span class="text-zonura-navy font-bold truncate max-w-[200px]">{{ product.title }}</span>
  </nav>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 xl:gap-12 relative">
    
    <!-- Column 1: Asset Gallery (col-span-4) -->
    <div class="lg:col-span-4 flex flex-col gap-4">
      <!-- Main Scrollable Gallery -->
      <div class="flex overflow-x-auto snap-x snap-mandatory gap-4 pb-2 w-full hide-scrollbar">
        {% for image in product.images %}
          <div class="group relative w-full shrink-0 snap-center aspect-[4/5] bg-zonura-sand/20 rounded-[14px] overflow-hidden border border-zonura-secondary/10 cursor-zoom-in">
            <img src="{{ image.src | img_url: '1000x' }}" alt="{{ image.alt | escape | default: product.title | escape }}" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-150 origin-center" />
          </div>
        {% else %}
          <div class="relative w-full shrink-0 snap-center aspect-[4/5] bg-zonura-sand/20 rounded-[14px] overflow-hidden border border-zonura-secondary/10 flex items-center justify-center">
            {{ 'product-1' | placeholder_svg_tag: 'w-full h-full object-cover text-zonura-navy/10' }}
          </div>
        {% endfor %}
      </div>
      <!-- Thumbnails (Hidden on mobile, scrollable on desktop) -->
      <div class="hidden md:flex overflow-x-auto gap-4 pb-2 hide-scrollbar w-full">
        {% for image in product.images %}
          <div class="relative w-20 h-20 shrink-0 bg-zonura-sand/20 rounded-[14px] overflow-hidden border border-zonura-navy/5 cursor-pointer hover:border-zonura-gold transition-colors" onclick="document.querySelector('.snap-x').scrollTo({left: {{ forloop.index0 }} * document.querySelector('.snap-x').clientWidth, behavior: 'smooth'})">
            <img src="{{ image.src | img_url: '400x' }}" alt="{{ image.alt | escape | default: product.title | escape }}" class="w-full h-full object-cover" />
          </div>
        {% endfor %}
      </div>
    </div>

    <!-- Column 2: Information Feed (col-span-5) -->
    <div class="lg:col-span-5 flex flex-col">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'title' %}
            <h1 class="font-serif text-4xl lg:text-6xl text-zonura-navy leading-tight mb-2 font-light luxury-fade-up" {{ block.shopify_attributes }}>
              {{ product.title }}
            </h1>
          {% when 'rating' %}
            <div class="mb-4" {{ block.shopify_attributes }}>
              {% render 'judgeme_widgets', widget_type: 'judgeme_preview_badge', jm_style: '', concierge_install: true, product: product %}
            </div>
          {% when 'separator' %}
            <div class="h-[1px] w-full bg-zonura-navy/10 mb-6" {{ block.shopify_attributes }}></div>
          {% when 'description' %}
            <div class="font-sans text-sm text-zonura-navy/80 leading-relaxed font-light mb-8 prose max-w-none luxury-fade-up luxury-delay-100" {{ block.shopify_attributes }}>
              {{ product.description }}
            </div>
          {% when 'specifications' %}
            <div class="mt-8 luxury-fade-up luxury-delay-100" {{ block.shopify_attributes }}>
              <h3 class="font-sans font-bold text-xs text-zonura-navy uppercase tracking-widest mb-4">Specifications</h3>
              <div class="border border-zonura-secondary/20 rounded-md overflow-hidden font-sans text-sm shadow-sm">
                <table class="w-full text-left border-collapse">
                  <tbody>
                    <tr class="border-b border-zonura-secondary/10 bg-zonura-sand/30">
                      <th class="py-3 px-4 font-medium text-zonura-navy/70 w-1/3">Brand</th>
                      <td class="py-3 px-4 text-zonura-navy">{{ product.vendor }}</td>
                    </tr>
                    <tr class="border-b border-zonura-secondary/10">
                      <th class="py-3 px-4 font-medium text-zonura-navy/70 w-1/3">Product Type</th>
                      <td class="py-3 px-4 text-zonura-navy">{{ product.type }}</td>
                    </tr>
                    <tr>
                      <th class="py-3 px-4 font-medium text-zonura-navy/70 w-1/3">Availability</th>
                      <td class="py-3 px-4 text-zonura-navy">{% if product.available %}In Stock{% else %}Out of Stock{% endif %}</td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
        {% endcase %}
      {% endfor %}
    </div>

    <!-- Column 3: The Buy Box Card (col-span-3) -->
    <div class="lg:col-span-3">
      <div class="sticky top-40 flex flex-col gap-6 luxury-fade-up luxury-delay-200">
        
        <div class="flex flex-col">
          <span class="font-serif text-4xl font-medium text-zonura-navy mb-1">
            {{ product.price | money }}
          </span>
          {% if product.compare_at_price > product.price %}
            <span class="font-sans text-sm text-zonura-navy/50 line-through">
              {{ product.compare_at_price | money }}
            </span>
          {% endif %}
          <p class="font-sans text-xs text-zonura-navy/50 font-medium mt-1">inclusive of all taxes</p>
        </div>

        <div>
          {% if product.available %}
            {% assign inventory = product.variants.first.inventory_quantity %}
            {% if inventory > 0 and inventory < 10 %}
              <span class="inline-flex items-center gap-1.5 text-sm font-bold text-zonura-alert font-sans mb-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
                Low Stock — Only {{ inventory }} left!
              </span>
            {% else %}
              <span class="inline-flex items-center gap-1.5 text-sm font-medium text-zonura-navy/80 font-sans mb-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                In Stock - Ships Tomorrow
              </span>
            {% endif %}
          {% else %}
            <span class="inline-flex items-center gap-1.5 text-sm font-medium text-zonura-navy/60 font-sans">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
              Sold Out
            </span>
          {% endif %}
          
          {% if section.settings.show_urgency_signals %}
            <!-- Urgency Signals -->
            <div class="mt-4 flex flex-col gap-2">
              <div class="flex items-center gap-2 font-sans text-xs font-medium text-zonura-navy/80">
                <span>🔥</span> <span id="viewer-count">...</span> people are viewing this right now
              </div>
              <div class="flex items-center gap-2 font-sans text-xs text-zonura-navy/80">
                <span>⚡</span> Order in next <span id="delivery-countdown" class="font-medium">...</span> for delivery by <span id="delivery-date" class="font-medium">...</span>
              </div>
            </div>
          {% endif %}
          
          <p class="font-sans text-xs text-zonura-navy/50 mt-4 mb-2">Ships directly from ZONURA warehouses. Secure transaction.</p>
        </div>

        <!-- Buy Box Form -->
        {% form 'product', product, class: 'flex flex-col gap-3', id: 'main-atc-form' %}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          
          <button type="submit" name="add" id="main-atc-button" class="w-full py-4 flex items-center justify-center gap-2 rounded-full bg-zonura-action hover:bg-zonura-navy text-white font-medium font-sans text-sm tracking-widest transition-colors {% unless product.available %}opacity-50 cursor-not-allowed{% endunless %}" {% unless product.available %}disabled{% endunless %}>
            {% if product.available %}Add to Cart{% else %}Out of Stock{% endif %}
          </button>
          
          <div class="flex items-center justify-between mt-2 px-1">
            <a href="/policies/shipping-policy" class="flex items-center gap-1 text-xs font-sans text-zonura-secondary hover:text-zonura-navy transition-colors underline underline-offset-4">
              Shipping Info
            </a>
            <a href="/policies/refund-policy" class="flex items-center gap-1 text-xs font-sans text-zonura-secondary hover:text-zonura-navy transition-colors underline underline-offset-4">
              Return Policy
            </a>
          </div>
          
          {% if product.available %}
            <div class="shopify-payment-button-wrapper mt-1">
              {{ form | payment_button }}
            </div>
            <!-- Fallback Buy Now if dynamic checkout is disabled -->
            <button type="button" class="w-full py-3.5 flex items-center justify-center gap-2 rounded-[14px] border-2 border-zonura-navy text-zonura-navy font-bold font-sans text-sm tracking-wide transition-colors hover:bg-zonura-sand hidden fallback-buy-now">
              Buy Now
            </button>
          {% endif %}
        {% endform %}
        
        <button type="button" class="wishlist-btn w-full py-3 flex items-center justify-center gap-2 text-zonura-navy/60 hover:text-zonura-navy font-medium font-sans text-sm tracking-wide transition-colors border-b border-transparent hover:border-zonura-navy/20 self-start mt-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" /></svg>
          Add to Wishlist
        </button>

        <div class="flex flex-col items-center justify-center gap-2 mt-6 pt-6 border-t border-zonura-secondary/20">
          <div class="flex items-center gap-2 text-zonura-secondary">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
            <span class="font-sans text-xs uppercase tracking-widest font-bold">Secure SSL Checkout</span>
          </div>
          <div class="flex items-center gap-2 mt-2 opacity-60 grayscale hover:grayscale-0 transition-all">
            {{ 'visa' | payment_type_svg_tag: class: 'w-10 h-6' }}
            {{ 'master' | payment_type_svg_tag: class: 'w-10 h-6' }}
            {{ 'american_express' | payment_type_svg_tag: class: 'w-10 h-6' }}
            {{ 'paypal' | payment_type_svg_tag: class: 'w-10 h-6' }}
            {{ 'apple_pay' | payment_type_svg_tag: class: 'w-10 h-6' }}
          </div>
        </div>

      </div>
    </div>
  </div>
</div>

<!-- Sticky ATC Bar (Mobile) -->
<div id="sticky-atc-bar" class="fixed bottom-0 left-0 w-full bg-white border-t border-zonura-navy/10 p-4 shadow-[0_-10px_30px_rgba(14,30,46,0.1)] z-50 transform translate-y-full transition-transform duration-300 md:hidden flex items-center justify-between gap-4">
  <div class="flex items-center gap-3 flex-1 min-w-0">
    <img src="{{ product.featured_image | img_url: '100x' }}" alt="{{ product.title | escape }}" class="w-10 h-10 rounded-md object-cover shrink-0">
    <div class="flex flex-col min-w-0">
      <span class="font-sans font-bold text-sm text-zonura-navy truncate">{{ product.title }}</span>
      <span class="font-serif text-sm text-zonura-navy/80">{{ product.price | money }}</span>
    </div>
  </div>
  {% form 'product', product %}
    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
    <button type="submit" name="add" class="shrink-0 bg-zonura-navy text-white px-6 py-2.5 rounded-full font-sans font-bold text-xs tracking-widest uppercase hover:bg-zonura-gold hover:text-zonura-navy transition-colors {% unless product.available %}opacity-50 cursor-not-allowed{% endunless %}" {% unless product.available %}disabled{% endunless %}>
      {% if product.available %}Add to Cart{% else %}Sold Out{% endif %}
    </button>
  {% endform %}
</div>

{% schema %}
{
  "name": "Product Layout",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_urgency_signals",
      "label": "Show Urgency Signals",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "title",
      "name": "Title",
      "limit": 1
    },
    {
      "type": "rating",
      "name": "Product Rating",
      "limit": 1
    },
    {
      "type": "separator",
      "name": "Separator"
    },
    {
      "type": "description",
      "name": "Description",
      "limit": 1
    },
    {
      "type": "specifications",
      "name": "Specifications Table",
      "limit": 1
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "title"
      },
      {
        "type": "rating"
      },
      {
        "type": "separator"
      },
      {
        "type": "description"
      }
    ]
  }
}
{% endschema %}
