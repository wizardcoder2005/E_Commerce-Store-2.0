<div class="bg-white py-16 md:py-24 border-t border-zonura-navy/5">
  <div class="max-w-[1600px] mx-auto px-4 md:px-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-12 md:gap-24">
      
      <!-- Left Image -->
      <div class="w-full md:w-1/2 flex justify-center bg-[#f0f3f2] p-8 rounded-premium luxury-fade-up">
        {% if section.settings.image != blank %}
          <img src="{{ section.settings.image | img_url: '800x' }}" alt="Newsletter Image" class="w-full max-w-md object-contain mix-blend-multiply">
        {% else %}
          {{ 'image' | placeholder_svg_tag: 'w-full max-w-md h-64 text-zonura-navy/20' }}
        {% endif %}
      </div>

      <!-- Right Content -->
      <div class="w-full md:w-1/2 flex flex-col luxury-fade-up luxury-delay-200">
        <h2 class="font-serif text-4xl md:text-5xl lg:text-6xl text-zonura-navy leading-tight mb-8 max-w-xl">
          {{ section.settings.heading }}
        </h2>

        {% form 'customer', class: 'w-full max-w-md relative' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="relative flex items-center border-b border-zonura-navy/20 focus-within:border-zonura-navy transition-colors pb-2">
            <input 
              type="email" 
              name="contact[email]" 
              id="Email" 
              class="w-full bg-transparent font-sans text-sm text-zonura-navy placeholder:text-zonura-navy/40 focus:outline-none py-2" 
              placeholder="{{ section.settings.placeholder }}"
              required
            >
            <button type="submit" class="absolute right-0 top-1/2 -translate-y-1/2 text-zonura-navy hover:text-zonura-gold transition-colors p-2 focus:outline-none">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
            </button>
          </div>
          {% if form.posted_successfully? %}
            <p class="mt-4 font-sans text-sm text-green-700">Thanks for subscribing!</p>
          {% endif %}
          {% if form.errors %}
            <p class="mt-4 font-sans text-sm text-red-600">{{ form.errors | default_errors }}</p>
          {% endif %}
        {% endform %}
      </div>
      
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Newsletter Split",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Join our Newsletter — Get Updates, Offers and Invites."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input Placeholder",
      "default": "Email address"
    }
  ],
  "presets": [
    {
      "name": "Newsletter Split",
      "category": "Promotional"
    }
  ]
}
{% endschema %}
