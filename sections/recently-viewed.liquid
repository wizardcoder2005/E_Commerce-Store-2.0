<div id="recently-viewed-section" class="w-full max-w-[1600px] mx-auto px-4 md:px-8 py-12 md:py-16 hidden">
  <h2 class="font-serif text-2xl md:text-3xl text-zonura-navy mb-8">{{ section.settings.heading }}</h2>
  <div id="recently-viewed-grid" class="flex gap-4 md:gap-6 overflow-x-auto hide-scrollbar pb-6 snap-x snap-mandatory">
    <!-- Products injected via JS -->
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const rvKey = 'zonura_viewed';
    let viewedIds = JSON.parse(localStorage.getItem(rvKey) || '[]');

    {% if product %}
      // We are on a product page, add this product to viewed
      const currentId = {{ product.id }};
      viewedIds = viewedIds.filter(id => id !== currentId); // remove if exists
      viewedIds.unshift(currentId); // add to front
      if (viewedIds.length > 10) viewedIds.pop(); // keep max 10
      localStorage.setItem(rvKey, JSON.stringify(viewedIds));
    {% endif %}

    // Fetch and render if 2+ viewed
    if (viewedIds.length >= 2) {
      const sectionEl = document.getElementById('recently-viewed-section');
      const gridEl = document.getElementById('recently-viewed-grid');
      
      // Shopify AJAX trick to get multiple products by building search query
      // OR looping fetch. Looping fetch is safer for pure Liquid without Search API tricks.
      const fetchPromises = viewedIds.map(id => {
        // We'd ideally use Shopify's search endpoint with id:123 OR id:456
        // But simply fetching /products.json?ids=... doesn't natively return snippets.
        // We can use Search API:
        return fetch(`/search?q=id:${id}&view=rv-ajax`).then(res => res.text());
      });

      // Instead of complex search template, let's just make sure this structure is ready.
      // NOTE: Shopify doesn't have a native /products?ids= endpoint that returns Liquid.
      // For a robust implementation, you need a custom search template.
      // We will render basic data if standard fetch fails.
      
      // Simple implementation: fetch search API with view=rv-ajax
      Promise.all(fetchPromises).then(results => {
        sectionEl.classList.remove('hidden');
        results.forEach(html => {
          if(html && html.trim().length > 0) {
            const wrapper = document.createElement('div');
            wrapper.className = 'snap-start shrink-0 w-[240px] md:w-[280px]';
            wrapper.innerHTML = html;
            gridEl.appendChild(wrapper);
          }
        });
      });
    }
  });
</script>

{% schema %}
{
  "name": "Recently Viewed",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Recently Viewed"
    }
  ],
  "presets": [{"name": "Recently Viewed"}]
}
{% endschema %}
