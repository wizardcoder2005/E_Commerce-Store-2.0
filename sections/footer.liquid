      </div>

      <!-- Column 2: Quick Links -->
      <div class="flex flex-col gap-4">
        <h3 class="font-sans font-bold text-sm text-zonura-sand uppercase tracking-widest mb-2">Quick Links</h3>
        <a href="/" class="font-sans text-sm text-zonura-sand/60 hover:text-zonura-gold transition-colors">Home</a>
        <a href="/collections/all" class="font-sans text-sm text-zonura-sand/60 hover:text-zonura-gold transition-colors">Shop All</a>
        <a href="/pages/about-us" class="font-sans text-sm text-zonura-sand/60 hover:text-zonura-gold transition-colors">About Us</a>
        <a href="/blogs/news" class="font-sans text-sm text-zonura-sand/60 hover:text-zonura-gold transition-colors">Blog</a>
      </div>

      <!-- Column 3: Customer Support -->
      <div class="flex flex-col gap-4">
        <h3 class="font-sans font-bold text-sm text-zonura-sand uppercase tracking-widest mb-2">Customer Support</h3>
        <a href="/pages/track" class="font-sans text-sm text-zonura-sand/60 hover:text-zonura-gold transition-colors">Track Order</a>
        <a href="/pages/returns" class="font-sans text-sm text-zonura-sand/60 hover:text-zonura-gold transition-colors">Returns & Refunds</a>
        <a href="/pages/contact" class="font-sans text-sm text-zonura-sand/60 hover:text-zonura-gold transition-colors">Contact Us</a>
        <a href="/pages/faq" class="font-sans text-sm text-zonura-sand/60 hover:text-zonura-gold transition-colors">FAQs</a>
      </div>

      <!-- Column 4: Policies -->
      <div class="flex flex-col gap-4">
        <h3 class="font-sans font-bold text-sm text-zonura-sand uppercase tracking-widest mb-2">Policies</h3>
        <a href="/policies/privacy-policy" class="font-sans text-sm text-zonura-sand/60 hover:text-zonura-gold transition-colors">Privacy Policy</a>
        <a href="/policies/terms-of-service" class="font-sans text-sm text-zonura-sand/60 hover:text-zonura-gold transition-colors">Terms of Service</a>
        <a href="/policies/shipping-policy" class="font-sans text-sm text-zonura-sand/60 hover:text-zonura-gold transition-colors">Shipping Policy</a>
        <a href="/policies/refund-policy" class="font-sans text-sm text-zonura-sand/60 hover:text-zonura-gold transition-colors">Cancellation Policy</a>
      </div>

    </div>
    
    <div class="h-[1px] w-full bg-zonura-sand/10 mb-8"></div>
    
    <div class="flex flex-col md:flex-row justify-between items-center gap-6">
      <div class="font-sans text-xs text-zonura-sand/40">
        &copy; 2026 Zonura. All rights reserved.
      </div>
      
      <!-- Payment Icons Strip -->
      <div class="flex items-center gap-3">
        <div class="bg-white/10 px-3 py-1 rounded text-[10px] font-bold text-zonura-sand tracking-wide">UPI</div>
        <div class="bg-white/10 px-3 py-1 rounded text-[10px] font-bold text-zonura-sand tracking-wide">Razorpay</div>
        <div class="bg-white/10 px-3 py-1 rounded text-[10px] font-bold text-zonura-sand tracking-wide">Visa</div>
        <div class="bg-white/10 px-3 py-1 rounded text-[10px] font-bold text-zonura-sand tracking-wide">Mastercard</div>
        <div class="bg-white/10 px-3 py-1 rounded text-[10px] font-bold text-zonura-sand tracking-wide">COD</div>
      </div>
    </div>

  </div>
</footer>

