<footer class="bg-zonura-navy text-zonura-sand pt-20 pb-8 border-t border-zonura-sand/10">
  <div class="max-w-[1600px] mx-auto px-4 md:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-{{ section.blocks.size }} gap-12 mb-16">
      
      {% for block in section.blocks %}
        <div class="flex flex-col luxury-fade-up" style="transition-delay: {{ forloop.index | times: 100 }}ms;" {{ block.shopify_attributes }}>
          {% case block.type %}
            {% when 'link_list' %}
              <h3 class="font-serif text-3xl text-zonura-sand mb-6">{{ block.settings.heading }}</h3>
              {% assign menu_handle = block.settings.menu | default: 'footer' %}
              {% assign footer_menu = linklists[menu_handle] %}
              {% if footer_menu.links.size > 0 %}
                <div class="flex flex-col gap-3">
                  {% for link in footer_menu.links %}
                    <a href="{{ link.url }}" class="font-sans text-sm text-zonura-sand/70 hover:text-white transition-colors">{{ link.title }}</a>
                  {% endfor %}
                </div>
              {% endif %}
            
            {% when 'social' %}
              <h3 class="font-serif text-3xl text-zonura-sand mb-6">{{ block.settings.heading }}</h3>
              <div class="flex items-center gap-4 text-zonura-sand/60">
                {% if settings.social_facebook_link != blank %}
                  <a href="{{ settings.social_facebook_link }}" class="hover:text-white transition-colors" aria-label="Facebook">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" /></svg>
                  </a>
                {% endif %}
                {% if settings.social_instagram_link != blank %}
                  <a href="{{ settings.social_instagram_link }}" class="hover:text-white transition-colors" aria-label="Instagram">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z" /></svg>
                  </a>
                {% endif %}
                <a href="#" class="hover:text-white transition-colors" aria-label="TikTok">
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.95v7.45c-.01 1.94-.69 3.89-1.99 5.34-1.35 1.54-3.4 2.5-5.5 2.59-2.05.11-4.14-.38-5.83-1.6-1.76-1.26-2.92-3.32-3.13-5.5-.23-2.31.54-4.68 2.05-6.38 1.47-1.67 3.65-2.65 5.89-2.73v4.18c-.85.03-1.68.32-2.34.86-.68.55-1.14 1.34-1.26 2.22-.13 1.05.15 2.15.82 2.92.67.79 1.69 1.25 2.74 1.24 1.16-.01 2.26-.61 2.89-1.6.49-.8.74-1.74.75-2.69V.02z" /></svg>
                </a>
                <a href="#" class="hover:text-white transition-colors" aria-label="X (Twitter)">
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" /></svg>
                </a>
              </div>
          {% endcase %}
        </div>
      {% endfor %}

    </div>
    
    <div class="h-[1px] w-full bg-zonura-sand/10 mb-8"></div>
    
    <div class="flex flex-col md:flex-row justify-between items-center gap-6">
      <div class="font-sans text-xs text-zonura-sand/60">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}, Powered by Shopify
      </div>
      
      <div class="flex flex-wrap items-center gap-4 md:gap-6 font-sans text-xs text-zonura-sand/60">
        <a href="/pages/about-us" class="hover:text-white transition-colors">About Us</a>
        <a href="/pages/contact" class="hover:text-white transition-colors">Contact</a>
        <a href="/policies/privacy-policy" class="hover:text-white transition-colors">Privacy Policy</a>
        <a href="/policies/terms-of-service" class="hover:text-white transition-colors">Terms of Service</a>
        <a href="/policies/refund-policy" class="hover:text-white transition-colors">Refund Policy</a>
      </div>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "max_blocks": 4,
  "settings": [],
  "blocks": [
    {
      "type": "link_list",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    },
    {
      "type": "social",
      "name": "Social Media",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Stay Connected"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "link_list",
        "settings": {
          "heading": "Shop"
        }
      },
      {
        "type": "link_list",
        "settings": {
          "heading": "Help"
        }
      },
      {
        "type": "link_list",
        "settings": {
          "heading": "About"
        }
      },
      {
        "type": "social",
        "settings": {
          "heading": "Stay Connected"
        }
      }
    ]
  }
}
{% endschema %}
