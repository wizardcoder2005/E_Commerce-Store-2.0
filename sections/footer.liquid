<footer class="bg-zonura-navy text-zonura-sand pt-24 md:pt-32 pb-12">
  <div class="max-w-[1600px] mx-auto px-4 md:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-{{ section.blocks.size }} gap-12 mb-16">
      
      {% for block in section.blocks %}
        <div class="flex flex-col gap-4 luxury-fade-up" style="transition-delay: {{ forloop.index | times: 100 }}ms;" {{ block.shopify_attributes }}>
          {% case block.type %}
            {% when 'text' %}
              <h3 class="font-sans font-medium text-xs text-zonura-sand/80 uppercase tracking-widest mb-4">{{ block.settings.heading }}</h3>
              <div class="font-sans text-sm text-zonura-sand/60 max-w-xs leading-relaxed prose prose-invert">
                {{ block.settings.text }}
              </div>
              {% if section.settings.show_social and forloop.first %}
                <div class="flex items-center gap-4 text-zonura-sand mt-2">
                  {% if settings.social_instagram_link != blank %}
                    <a href="{{ settings.social_instagram_link }}" class="hover:text-zonura-gold transition-colors">Instagram</a>
                  {% endif %}
                  {% if settings.social_facebook_link != blank %}
                    <a href="{{ settings.social_facebook_link }}" class="hover:text-zonura-gold transition-colors">Facebook</a>
                  {% endif %}
                  {% if settings.social_youtube_link != blank %}
                    <a href="{{ settings.social_youtube_link }}" class="hover:text-zonura-gold transition-colors">YouTube</a>
                  {% endif %}
                </div>
              {% endif %}
            
            {% when 'link_list' %}
              <h3 class="font-sans font-medium text-xs text-zonura-sand/80 uppercase tracking-widest mb-4">{{ block.settings.heading }}</h3>
              {% assign footer_menu = linklists[block.settings.menu] %}
              {% if footer_menu.links.size > 0 %}
                {% for link in footer_menu.links %}
                  <a href="{{ link.url }}" class="font-sans text-sm text-zonura-sand/60 hover:text-zonura-gold transition-colors">{{ link.title }}</a>
                {% endfor %}
              {% endif %}
          {% endcase %}
        </div>
      {% endfor %}

    </div>
    
    <div class="h-[1px] w-full bg-zonura-sand/10 mb-8"></div>
    
    <div class="flex flex-col md:flex-row justify-between items-center gap-6">
      <div class="font-sans text-xs text-zonura-sand/40">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.
      </div>
      
      {% if section.settings.show_payment_icons %}
        <div class="flex items-center gap-3">
          {% for type in shop.enabled_payment_types %}
            {{ type | payment_type_svg_tag: class: 'w-8 h-8 opacity-70' }}
          {% else %}
            <!-- Fallback icons -->
            <div class="bg-white/10 px-3 py-1 rounded text-[10px] font-bold text-zonura-sand tracking-wide">UPI</div>
            <div class="bg-white/10 px-3 py-1 rounded text-[10px] font-bold text-zonura-sand tracking-wide">Cards</div>
            <div class="bg-white/10 px-3 py-1 rounded text-[10px] font-bold text-zonura-sand tracking-wide">COD</div>
          {% endfor %}
        </div>
      {% endif %}
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "max_blocks": 4,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social media icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Quick Links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "About Us"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Share store details, promotions, or brand content with your customers.</p>"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "text"
      },
      {
        "type": "link_list"
      }
    ]
  }
}
{% endschema %}
